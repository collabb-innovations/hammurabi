{
  "name": "@collabb/hammurabi",
  "version": "0.5.1",
  "description": "Spec → rubric → fixtures → runner. Trust your outputs without re-reading every diff.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collabb-innovations/hammurabi.git"
  },
  "homepage": "https://hammurabi.collabb.ai",
  "bugs": {
    "url": "https://github.com/collabb-innovations/hammurabi/issues"
  },
  "license": "MIT",
  "keywords": [
    "llm",
    "eval",
    "evaluation",
    "rubric",
    "judge",
    "anthropic",
    "claude",
    "ai",
    "testing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hammurabi-run": "./dist/cli/run.js",
    "hammurabi-check": "./dist/cli/check.js",
    "hammurabi-propose": "./dist/cli/propose.js",
    "hammurabi-select": "./dist/cli/select.js",
    "hammurabi-lock": "./dist/cli/lock.js",
    "hammurabi-verify": "./dist/cli/verify.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./loaders": {
      "types": "./dist/loaders/index.d.ts",
      "import": "./dist/loaders/index.js"
    },
    "./cli": {
      "types": "./dist/cli/report-md.d.ts",
      "import": "./dist/cli/report-md.js"
    },
    "./schema/proposal.schema.json": "./schema/proposal.schema.json",
    "./schema/selection.schema.json": "./schema/selection.schema.json",
    "./schema/lock.schema.json": "./schema/lock.schema.json"
  },
  "files": [
    "dist/",
    "schema/",
    "commands/",
    "templates/",
    "docs/",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "postbuild": "chmod +x dist/cli/run.js dist/cli/check.js dist/cli/propose.js dist/cli/select.js dist/cli/lock.js dist/cli/verify.js",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/preflight-publish.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:worker": "node scripts/check-worker-bundle.mjs",
    "smoke": "tsx examples/smoke/run.ts",
    "smoke:disk": "tsx examples/smoke/disk/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "@google/genai": "^1.40.0",
    "gray-matter": "^4.0.3",
    "openai": "^4.104.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
